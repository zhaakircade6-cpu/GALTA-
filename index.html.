<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GALTA Travel & Logistic Agency</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    color:#172033;
    background:#f7f9fc;
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

img{
    max-width:100%;
    display:block;
}

.container{
    width:92%;
    max-width:1200px;
    margin:auto;
}

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:#ffffff;
    box-shadow:0 2px 12px rgba(0,0,0,.08);
}

.navbar{
    min-height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    font-size:22px;
    font-weight:800;
    color:#063b70;
}

.logo span{
    color:#e79a18;
}

nav{
    display:flex;
    align-items:center;
    gap:20px;
}

nav a{
    font-weight:600;
    color:#172033;
    transition:.3s;
}

nav a:hover{
    color:#e79a18;
}

.menu-btn{
    display:none;
    border:0;
    background:#063b70;
    color:white;
    font-size:24px;
    padding:8px 12px;
    border-radius:8px;
    cursor:pointer;
}

/* HERO */
.hero{
    min-height:650px;
    display:flex;
    align-items:center;
    background:
    linear-gradient(rgba(3,34,67,.72),rgba(3,34,67,.72)),
    url("https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1800&q=80")
    center/cover no-repeat;
    color:white;
}

.hero-content{
    max-width:720px;
    padding:80px 0;
}

.hero h1{
    font-size:56px;
    line-height:1.1;
    margin-bottom:20px;
}

.hero h1 span{
    color:#f5ae2e;
}

.hero p{
    font-size:20px;
    margin-bottom:30px;
}

.btn-group{
    display:flex;
    flex-wrap:wrap;
    gap:14px;
}

.btn{
    display:inline-block;
    padding:13px 22px;
    border-radius:8px;
    border:none;
    cursor:pointer;
    font-weight:700;
    font-size:15px;
    transition:.3s;
}

.btn-primary{
    background:#e79a18;
    color:white;
}

.btn-primary:hover{
    background:#c77e08;
    transform:translateY(-2px);
}

.btn-light{
    background:white;
    color:#063b70;
}

.btn-light:hover{
    background:#eef3f8;
}

/* SECTIONS */
section{
    padding:80px 0;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title h2{
    font-size:38px;
    color:#063b70;
    margin-bottom:10px;
}

.section-title p{
    color:#667085;
}

/* QUICK CARDS */
.quick-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
    margin-top:-70px;
    position:relative;
    z-index:5;
}

.quick-card{
    background:white;
    padding:28px 20px;
    text-align:center;
    border-radius:12px;
    box-shadow:0 10px 30px rgba(0,0,0,.12);
}

.quick-card .icon{
    font-size:40px;
    margin-bottom:10px;
}

.quick-card h3{
    color:#063b70;
    margin-bottom:8px;
}

/* ABOUT */
.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:center;
}

.about-image{
    min-height:420px;
    border-radius:16px;
    background:
    linear-gradient(rgba(3,34,67,.2),rgba(3,34,67,.2)),
    url("https://images.unsplash.com/photo-1527631746610-bca00a040d60?auto=format&fit=crop&w=1000&q=80")
    center/cover;
}

.about-text h2{
    font-size:38px;
    color:#063b70;
    margin-bottom:18px;
}

.about-text p{
    margin-bottom:15px;
    color:#566174;
}

/* SERVICES */
.services-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:24px;
}

.service-card{
    background:white;
    padding:30px;
    border-radius:14px;
    box-shadow:0 6px 25px rgba(0,0,0,.07);
    border-top:4px solid #e79a18;
}

.service-card .icon{
    font-size:42px;
    margin-bottom:12px;
}

.service-card h3{
    color:#063b70;
    margin-bottom:10px;
}

.service-card p{
    color:#667085;
    margin-bottom:18px;
}

/* COUNTRIES */
.countries{
    background:#eef5fb;
}

.country-grid{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:16px;
}

.country-card{
    background:white;
    padding:20px 12px;
    text-align:center;
    border-radius:10px;
    cursor:pointer;
    font-weight:700;
    color:#063b70;
    box-shadow:0 4px 15px rgba(0,0,0,.06);
    transition:.3s;
}

.country-card:hover{
    transform:translateY(-4px);
    background:#063b70;
    color:white;
}

/* FORMS */
.form-section{
    background:white;
}

.form-box{
    max-width:900px;
    margin:auto;
    background:#f7f9fc;
    padding:35px;
    border-radius:15px;
    box-shadow:0 8px 30px rgba(0,0,0,.08);
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.form-group{
    display:flex;
    flex-direction:column;
}

.form-group.full{
    grid-column:1/-1;
}

.form-group label{
    font-weight:700;
    margin-bottom:7px;
    color:#344054;
}

.form-group input,
.form-group select,
.form-group textarea{
    width:100%;
    padding:13px;
    border:1px solid #d0d5dd;
    border-radius:8px;
    background:white;
    font-size:15px;
    outline:none;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{
    border-color:#063b70;
}

.form-group textarea{
    min-height:120px;
    resize:vertical;
}

.form-actions{
    margin-top:22px;
    display:flex;
    flex-wrap:wrap;
    gap:12px;
}

/* GALLERY */
.gallery-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.gallery-item{
    height:250px;
    overflow:hidden;
    border-radius:12px;
}

.gallery-item img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.4s;
}

.gallery-item:hover img{
    transform:scale(1.08);
}

/* CONTACT */
.contact{
    background:#063b70;
    color:white;
}

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
}

.contact h2{
    font-size:38px;
    margin-bottom:15px;
}

.contact p{
    margin-bottom:12px;
}

.contact-card{
    background:white;
    color:#172033;
    padding:30px;
    border-radius:14px;
}

.contact-list{
    list-style:none;
}

.contact-list li{
    padding:10px 0;
    border-bottom:1px solid #eee;
}

.whatsapp-list{
    display:grid;
    gap:10px;
    margin-top:20px;
}

.whatsapp-btn{
    display:block;
    background:#25D366;
    color:white;
    padding:12px 16px;
    border-radius:8px;
    text-align:center;
    font-weight:700;
}

.whatsapp-btn:hover{
    background:#1da851;
}

/* FOOTER */
footer{
    background:#031d36;
    color:white;
    text-align:center;
    padding:28px 15px;
}

footer p{
    margin:5px;
}

/* FLOATING WHATSAPP */
.whatsapp-float{
    position:fixed;
    right:20px;
    bottom:20px;
    width:58px;
    height:58px;
    border-radius:50%;
    background:#25D366;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    z-index:2000;
    box-shadow:0 5px 20px rgba(0,0,0,.25);
}

/* MODAL */
.modal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.65);
    z-index:3000;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal-content{
    background:white;
    width:100%;
    max-width:500px;
    border-radius:14px;
    padding:30px;
    position:relative;
}

.close{
    position:absolute;
    right:18px;
    top:12px;
    font-size:28px;
    cursor:pointer;
    color:#667085;
}

.modal-content h3{
    color:#063b70;
    margin-bottom:12px;
}

.modal-content p{
    color:#667085;
}

/* RESPONSIVE */
@media(max-width:900px){

    .menu-btn{
        display:block;
    }

    nav{
        display:none;
        position:absolute;
        top:72px;
        left:0;
        width:100%;
        background:white;
        padding:20px;
        flex-direction:column;
        box-shadow:0 8px 20px rgba(0,0,0,.1);
    }

    nav.active{
        display:flex;
    }

    .hero h1{
        font-size:42px;
    }

    .quick-grid{
        grid-template-columns:repeat(2,1fr);
        margin-top:-40px;
    }

    .about-grid,
    .contact-grid{
        grid-template-columns:1fr;
    }

    .services-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .country-grid{
        grid-template-columns:repeat(3,1fr);
    }
}

@media(max-width:600px){

    section{
        padding:60px 0;
    }

    .hero{
        min-height:600px;
    }

    .hero h1{
        font-size:35px;
    }

    .hero p{
        font-size:17px;
    }

    .quick-grid{
        grid-template-columns:1fr;
    }

    .services-grid,
    .gallery-grid,
    .country-grid{
        grid-template-columns:1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .form-group.full{
        grid-column:auto;
    }

    .form-box{
        padding:22px;
    }

    .section-title h2,
    .about-text h2,
    .contact h2{
        font-size:30px;
    }
}
</style>
</head>

